# Optional: public job posting API integration.
# If these values are empty, the analyzer uses built-in demo public-sector IT postings.
ALIO_OPEN_API_URL=https://opendata.alio.go.kr/your-json-endpoint
ALIO_OPEN_API_KEY=your-open-api-key
