NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Never expose to the client. Required for admin-privileged reads
# (e.g. job_descriptions) to bypass RLS; falls back to the anon client if unset.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: without any of these three, job posting collection still works —
# it falls back to the built-in ALIO JSON endpoint and job.alio.go.kr HTML scraping.

# Overrides the default ALIO OpenData JSON list endpoint (recrutInquiryAjaxList.do).
# ALIO_JSON_LIST_URL=

# A separately configured public-data API (e.g. data.go.kr) used as a second-tier
# source when the default ALIO JSON endpoint returns no results.
# ALIO_OPEN_API_URL=
# ALIO_OPEN_API_KEY=

# Overrides the job.alio.go.kr HTML recruit-list URL used as the third-tier source.
# JOB_ALIO_RECRUIT_URL=

# Optional: enables AI-written analysis summaries and the roadmap chat feature.
# Without it, the app runs fully on rule-based analysis (no functionality is lost).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Set to "true" to run the app with fixed demo data (no Supabase project or
# external job API required). See README.md "데모 모드" section for details.
NEXT_PUBLIC_DEMO_MODE=false
